{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShort__",
  "version": "2.0.0",
  "description": "__MSG_appDesc__",
  "minimum_chrome_version": "122",
  "permissions": [
    "storage",
    "offscreen",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/i18n-en.js",
        "src/memory-core.js",
        "src/linking.js",
        "src/page/policy.js",
        "src/page/adapters.js",
        "src/page/reader.js",
        "src/page/sitedata.js",
        "src/page/composer.js",
        "src/page/summarizer.js",
        "src/page/bridge.js",
        "src/page/ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html",
  "action": {
    "default_title": "ذاكرة المحادثة",
    "default_popup": "src/options.html?popup=1"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "default_locale": "ar"
}
